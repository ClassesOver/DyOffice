# Replace with images you have already synchronized to your OWN Huawei SWR repository.
# No anonymous public Huawei mirror or published DyOffice image is assumed.
NODE_IMAGE=
RUST_IMAGE=
POSTGRES_IMAGE=
DYOFFICE_DEPLOYMENT_ID=
NPM_REGISTRY=https://repo.huaweicloud.com/repository/npm/

# Default remains loopback with Secure cookies. LAN HTTP is explicit, unsafe dev only.
BIND_IP=127.0.0.1
HTTP_PORT=3080
DYOFFICE_ORIGIN=http://localhost:3080
DYOFFICE_INSECURE_HTTP_DEV=0
