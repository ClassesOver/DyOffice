NODE_ENV=development
DYOFFICE_DEPLOYMENT_ID=REPLACE_WITH_EXISTING_UUID
DYOFFICE_BUSINESS_DATABASE_URL=postgresql://dyoffice_business:REPLACE@127.0.0.1:5432/dyoffice
DYOFFICE_FILE_API=experimental
DYOFFICE_OBJECT_STORE=s3
DYOFFICE_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
DYOFFICE_S3_REGION=REPLACE
DYOFFICE_S3_ENDPOINT=https://REPLACE_WITH_S3_COMPATIBLE_ENDPOINT
DYOFFICE_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
DYOFFICE_NATIVE_BINARY=/opt/dyoffice/.dyoffice-native-build/xlsx-sidecar
DYOFFICE_NATIVE_SHA256=REPLACE_FROM_HOST_MANIFEST
HOST=127.0.0.1
PORT=3080
DYOFFICE_AUTH_MODE=local
DYOFFICE_AUTH_DATABASE_URL=postgresql://dyoffice_auth:REPLACE@127.0.0.1:5432/dyoffice
DYOFFICE_ORIGIN=http://localhost:3080
DYOFFICE_CSRF_KEY=REPLACE_WITH_EXISTING_SECRET
DYOFFICE_LOCAL_SHELL=experimental
DYOFFICE_LOCAL_SHELL_DIR=/opt/dyoffice/apps/web/dist
DYOFFICE_NATIVE_DOCX=experimental
DYOFFICE_NATIVE_XLSX=experimental
DYOFFICE_NATIVE_JOBS=experimental
DYOFFICE_CODING_AGENT=off
# Explicit isolated HTTP development only; see README risk notice.
DYOFFICE_INSECURE_HTTP_DEV=0
