[Unit]
Description=DyOffice experimental native worker (host template)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/dyoffice/worker.env
[Service]
Type=simple
User=root
WorkingDirectory=/opt/dyoffice
EnvironmentFile=/etc/dyoffice/worker.env
ExecStart=/usr/local/bin/node --experimental-transform-types apps/web/worker/src/main.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
# Controller needs systemd/root; isolation is applied by the original sandbox
# to each parser task. Do not substitute privileged Docker or bypass admission.
[Install]
WantedBy=multi-user.target
