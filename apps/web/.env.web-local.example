# Use the same deployment UUID as the administrator bootstrap.
DYOFFICE_DEPLOYMENT_ID=
DYOFFICE_AUTH_DATABASE_URL=
DYOFFICE_BUSINESS_DATABASE_URL=

# Set the exact browser origin of your HTTPS entry, without a trailing slash.
DYOFFICE_ORIGIN=
DYOFFICE_CSRF_KEY=

DYOFFICE_OBJECT_STORE=local-dev
DYOFFICE_OBJECT_DIRECTORY=.dyoffice/objects

# Optional: use an installed @bytebase/dbhub@2.1.0 entry point without launching npx.
# DYOFFICE_DBHUB_ENTRY=/absolute/path/to/node_modules/@bytebase/dbhub/dist/index.js
