{
  "name": "@dyoffice/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.mjs",
    "start": "node --import tsx server/index.mjs",
    "test": "node --import tsx --test test/*.test.mjs",
    "build": "vite build --config vite.config.mjs",
    "test:build": "node --test test/build/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
