{
  "name": "@dyoffice/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.mjs",
    "start": "node --import tsx server/index.mjs",
    "test": "node --import tsx --test test/*.test.mjs",
    "build": "vite build --config vite.config.mjs",
    "test:build": "node --test test/build/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "bootstrap:admin": "node tools/bootstrap-admin.mjs",
    "test:identity:integration": "node --test test/integration/*.test.mjs",
    "test:integration": "node tools/run-web-integration.mjs",
    "test:shell": "vitest run --config vitest.shell.config.mjs",
    "typecheck:shell": "tsc -p tsconfig.shell.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "fast-xml-parser": "5.12.0",
    "jsdom": "28.1.0",
    "jszip": "3.10.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "utif2": "4.1.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
