{
  "name": "@dyoffice/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server/index.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "vite build --config vite.config.mjs",
    "test:build": "node --experimental-strip-types --test test/build/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "test:integration": "node --experimental-strip-types --test test/integration/*.test.mjs",
    "test:e2e": "node --experimental-strip-types --test test/e2e/*.test.mjs",
    "test:storage": "node --experimental-strip-types --test test/storage/*.test.mjs",
    "test:jobs": "node --experimental-strip-types --test test/jobs/*.test.mjs",
    "test:sandbox": "node --experimental-strip-types --test --test-concurrency=1 test/sandbox/*.test.mjs",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test:native-jobs": "node --experimental-strip-types --test --test-concurrency=1 test/native-jobs/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "fastify": "5.12.8",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "jszip": "3.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
