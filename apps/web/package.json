{
  "name": "@dyoffice/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server/index.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "vite build --config vite.config.mjs",
    "test:build": "node --experimental-strip-types --test test/build/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "test:integration": "node --experimental-strip-types --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
