{
  "name": "@dyoffice/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.mjs",
    "start": "node --import tsx server/index.mjs",
    "test": "node --import tsx --test test/*.test.mjs",
    "build": "vite build --config vite.local-shell.config.mjs",
    "build:provider-probe": "vite build --config vite.provider-probe.config.mjs",
    "typecheck:provider-probe": "tsc -p tsconfig.provider-probe.json",
    "test:build": "node --import tsx --test test/build/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "test:integration": "node tools/run-web-integration.mjs",
    "test:e2e": "node --import tsx --test test/e2e/*.test.mjs",
    "test:storage": "node --experimental-transform-types --test test/storage/*.test.mjs",
    "test:jobs": "node --import tsx --test test/jobs/*.test.mjs",
    "test:sandbox": "node --experimental-transform-types --test --test-concurrency=1 test/sandbox/*.test.mjs test/host-native/*.test.mjs",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test:native-jobs": "node --import tsx --test --test-concurrency=1 test/native-jobs/*.test.mjs",
    "start:worker": "node --import tsx worker/src/main.ts",
    "build:sheets": "vite build --config vite.sheets.config.ts && node server/sheets/build.mjs",
    "test:native-sheets": "node --experimental-transform-types --import tsx --test --test-concurrency=1 test/native-sheets/*.test.mjs",
    "build:slides": "vite build --config vite.slides.config.ts",
    "build:pdf": "vite build --config vite.pdf.config.ts && node server/src/pdf/build-worker.mjs",
    "build:pdf-worker": "node server/src/pdf/build-worker.mjs",
    "test:native-slides": "NODE_ENV=test node --import tsx --test --test-concurrency=1 test/native-slides/*.test.mjs",
    "test:identity:integration": "node --test test/integration/*.test.mjs",
    "test:shell": "vitest run --config vitest.shell.config.mjs",
    "typecheck:shell": "tsc -p tsconfig.shell.json",
    "test:integration:local": "node --import tsx --test --test-concurrency=4 test/local-integration/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-s3": "3.1169.0",
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@node-rs/argon2": "2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "antd": "^6.7.1",
    "argon2": "0.45.2",
    "bullmq": "5.81.5",
    "cfb": "1.2.2",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "fastify": "5.12.8",
    "mysql2": "3.24.6",
    "negotiator": "1.1.0",
    "node-forge": "1.4.3",
    "node-sql-parser": "5.4.0",
    "officecrypto-tool": "^0.0.19",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "8.23.1",
    "pngjs": "^7.0.0",
    "prosemirror-collab": "1.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@e965/xlsx": "0.20.3",
    "@playwright/test": "1.62.1",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-bold": "3.31.0",
    "@tiptap/extension-document": "3.31.0",
    "@tiptap/extension-text": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@types/node": "24.13.3",
    "@types/node-forge": "1.3.14",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "28.1.0",
    "jszip": "3.10.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "utif2": "4.1.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
